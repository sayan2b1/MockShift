# MockShift Environment Configuration
# Add your Gemini API key below to enable AI PDF parsing, solving, mistake autopsy, and weakness drills.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default models if required
# Default: gemini-3.5-flash-lite (fast PDF extraction), gemini-3.6-flash (solving & reasoning)
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_SOLVER_MODEL=gemini-3.6-flash

# Allowed CORS origins (comma-separated, default is *)
CORS_ORIGINS=*


